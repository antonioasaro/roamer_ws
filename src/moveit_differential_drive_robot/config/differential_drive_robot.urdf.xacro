<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="differential_drive_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import differential_drive_robot urdf file -->
    <xacro:include filename="$(find gazebo_differential_drive_robot)/urdf/robot.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="differential_drive_robot.ros2_control.xacro" />


    <xacro:differential_drive_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
