<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Arm Links & Joints ==================== -->
  <xacro:property name="arm_offset" value="${body_length/2 - caster_radius}"/>

  <!-- Shoulder Joint (Rotation around Z) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="${arm_offset} 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Link 1 (Upper Arm) -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.3"/></geometry>
        <material name="link_1_material">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2"/>
      <mass value="0.5"/>
      <inertia ixx="0.0068" ixy="0" ixz="0" iyy="0.0068" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Elbow Joint (Rotation around Y) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Link 2 (Forearm) -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
        <material name="link_2_material">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.4"/>
      <inertia ixx="0.0031" ixy="0" ixz="0" iyy="0.0031" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== Gripper Base ==================== -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_2"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <geometry><box size="0.02 0.12 0.02"/></geometry>
        <material name="gripper_base_material">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
    </visual>
    <collision>
      <geometry><box size="0.02 0.12 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00012"/>
    </inertial>
  </link>

  <!-- ==================== Gripper Fingers ==================== -->
  <!-- Left Finger (Prismatic Active Joint) -->
  <!-- The main active joint controlled by the gripper plugin -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" lower="0.0" upper="0.04" velocity="0.2"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.06"/></geometry>
      <material name="left_finger_material">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000006" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Right Finger (Prismatic Mimic Joint) -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/> 
    <limit effort="20.0" lower="0.0" upper="0.04" velocity="0.2"/>
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.06"/></geometry>
        <material name="right_finger_material">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.01 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000006" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

</robot>